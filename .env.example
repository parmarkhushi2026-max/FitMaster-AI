# FitMaster AI - Production Environment Configuration Template
# Copy this file to .env and adjust values for production deployment

# General Settings
SECRET_KEY=django-insecure-change-this-in-production-super-secret-key-12345!
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# CSRF & Security
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SECURE_SSL_REDIRECT=False

# Database Configuration (Optional: Defaults to SQLite if DATABASE_URL is not set)
# DATABASE_URL=postgres://user:password@localhost:5432/fitmaster_db

# Email Configuration
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=notices@fitmaster.local
